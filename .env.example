# Copy to `.env` (gitignored) for local dev. On Render: set under Environment tab.

# === Anthropic ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# === Facebook (trainer page — DIFFERENT from the customer bot page) ===
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=zaisan-trainer-verify

# === GitHub ===
# Personal Access Token with `repo` scope. The bot uses this to read and commit
# to the target repo below. Never commit this token to git.
GITHUB_TOKEN=
GITHUB_OWNER=khuygbaataro
GITHUB_REPO=Zaisan_Tusul
GITHUB_BRANCH=main

# === Authorization ===
# Comma-separated list of Facebook PSIDs allowed to use this bot.
# Leave empty for first deploy — the bot will reply with your PSID so you can
# copy it here, then redeploy.
ALLOWED_PSIDS=

# === Optional ===
PORT=8080
